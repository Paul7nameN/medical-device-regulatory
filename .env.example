# ==============================================================================
# MED-THERM Compliance Engine - Docker Environment Variables
# ==============================================================================
# Copiaza acest fisier ca .env si completeaza valorile necesare.
# NOTA: .env contine secremente si NU trebuie commis pe GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# ModelArk AI Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Adauga MODELARK_API_KEY pentru a activa functionalitatile AI:
# - Analiza automata a chart-urilor din rapoarte
# - Rezumat inteligenta al erorilor de conformitate
#
# Daca nu aveti cheie, AI-ul va fi dezactivat si aplicatia va functiona
# in modul basic de validare.
# ------------------------------------------------------------------------------
MODELARK_API_KEY=your-modelark-api-key-here

# ------------------------------------------------------------------------------
# Optional overrides (doar daca aveti nevoie sa modificati valorile default)
# ------------------------------------------------------------------------------
# Acestea sunt predefinite in docker-compose.yml.
# Deblockati si modificati doar daca aveti nevoie:
# ------------------------------------------------------------------------------
# MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# MODEL_CHART_ANALYSIS=seed-2-0-pro-260328
# MODEL_TEXT_ANALYSIS=seed-2-0-pro-260328

# ------------------------------------------------------------------------------
# Frontend Vite Environment (pentru dezvoltare locala FARA Docker)
# ------------------------------------------------------------------------------
# Daca rulati frontend-ul direct pe calculator (nu in Docker),
# puteti seta aceste variabile in frontend/.env:
# ------------------------------------------------------------------------------
# VITE_API_TARGET=http://localhost:8000
# VITE_API_URL=http://localhost:8000
