# ------------------------------------------------------------------------------
# ModelArk AI Configuration
# ------------------------------------------------------------------------------
# Adauga MODELARK_API_KEY pentru a activa functionalitatile AI:
# - Analiza automata a chart-urilor din rapoarte
# - Rezumat inteligenta al erorilor de conformitate
#
# Daca nu aveti cheie, AI-ul va fi dezactivat si aplicatia va functiona
# in modul basic de validare.
# ------------------------------------------------------------------------------
MODELARK_API_KEY=your-modelark-api-key-here
