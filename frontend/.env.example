# ==============================================================================
# MED-THERM Frontend - Environment Variables
# ==============================================================================
# Acest fisier este pentru DEZVOLTARE LOCALA FARA Docker.
# Daca folositi Docker, variabilele sunt setate automat in docker-compose.yml.
#
# Copiaza acest fisier ca .env doar daca aveti nevoie sa modificati valorile.
# ==============================================================================

# ------------------------------------------------------------------------------
# Vite Dev Server Proxy Target
# ------------------------------------------------------------------------------
# Unde trimite request-urile /api in timpul dezvoltarii.
# Default (daca nu este setat): http://localhost:8000
#
# Modificati doar daca backend-ul ruleaza pe un alt port/host.
# ------------------------------------------------------------------------------
# VITE_API_TARGET=http://localhost:8000

# ------------------------------------------------------------------------------
# API Base URL (pentru build/productie)
# ------------------------------------------------------------------------------
# Folosit cand frontend-ul nu mai ruleaza prin Vite dev proxy.
# Lasati gol pentru a folosi URL-ul relativ (acelasi origin).
#
# Exemplu daca frontend-ul si backend-ul sunt pe domenii diferite:
# VITE_API_URL=https://api.example.com
# ------------------------------------------------------------------------------
# VITE_API_URL=
