# ==============================================================================
# MED-THERM Compliance Engine - Backend Environment Variables
# ==============================================================================
# Acest fisier este pentru DEZVOLTARE LOCALA FARA Docker.
# Daca folositi Docker, folositi fisierul .env din radacina proiectului.
#
# Copiaza acest fisier ca .env si completeaza valorile.
# NOTA: .env contine secremente si NU trebuie commis pe GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Settings
# ------------------------------------------------------------------------------
DEBUG=true
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Pentru PostgreSQL local. Modificati user, parola si nume BD dupa nevoie.
# Format: postgresql+psycopg2://user:password@host:port/database_name
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/med_therm
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:your_password_here@localhost:5432/med_therm

# ------------------------------------------------------------------------------
# ModelArk AI Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# Adauga MODELARK_API_KEY pentru a activa functionalitatile AI.
# Daca nu aveti cheie, setati AI_ENABLED=false sau lasati gol.
# ------------------------------------------------------------------------------
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_API_KEY=your-api-key-here
MODEL_CHART_ANALYSIS=seed-2-0-pro-260328
MODEL_TEXT_ANALYSIS=seed-2-0-pro-260328

# ------------------------------------------------------------------------------
# AI Timeouts & Retries
# ------------------------------------------------------------------------------
MODELARK_TIMEOUT=60
MODELARK_MAX_RETRIES=3
MODELARK_RETRY_DELAY=1.0

# ------------------------------------------------------------------------------
# AI Enable/Disable
# ------------------------------------------------------------------------------
# Setati la false daca nu aveti MODELARK_API_KEY
AI_ENABLED=false
